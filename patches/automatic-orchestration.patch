+++ b/src/main/runtime/orchestration/db/automatic-runs/automatic-report-delivery.ts
@@ -0,0 +1,52 @@
+import type { OrchestrationDb } from '../orchestration-db'
+import type { TaskRow, WorkerReportOutcome } from '../../types'
+import { recordAutomaticTaskDelivery } from './automatic-run-activity-store'
+
+/** Persist the worker completion contract, then the Task's durable delivery projection. */
+export function recordAutomaticWorkerDelivery(
+  db: OrchestrationDb,
+  task: TaskRow,
+  dispatchId: string,
+  outcome: WorkerReportOutcome,
+  result: string
+): void {
+  const report = parseWorkerResult(result)
+  recordAutomaticTaskDelivery.call(db, {
+    taskId: task.id,
+    runId: task.run_id,
+    dispatchId,
+    outcome,
+    summary: report.summary,
+    evidence: report.evidence,
+    ...(report.handoff ? { handoff: report.handoff } : {}),
+    ...(report.reviewVerdict ? { reviewVerdict: report.reviewVerdict } : {}),
+    codeVersion: task.code_version
+  })
+}
+
+function parseWorkerResult(result: string): {
+  summary: string
+  evidence: string[]
+  handoff?: string
+  reviewVerdict?: 'approved' | 'changes_requested'
+} {
+  try {
+    const parsed: unknown = JSON.parse(result)
+    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
+      return { summary: '', evidence: [] }
+    }
+    const record = parsed as Record<string, unknown>
+    return {
+      summary: typeof record.summary === 'string' ? record.summary : '',
+      evidence: Array.isArray(record.evidence)
+        ? record.evidence.filter((item): item is string => typeof item === 'string')
+        : [],
+      ...(typeof record.handoff === 'string' ? { handoff: record.handoff } : {}),
+      ...(record.reviewVerdict === 'approved' || record.reviewVerdict === 'changes_requested'
+        ? { reviewVerdict: record.reviewVerdict }
+        : {})
+    }
+  } catch {
+    return { summary: '', evidence: [] }
+  }
+}
diff --git a/src/main/runtime/orchestration/db/automatic-runs/automatic-run-activity-store.ts b/src/main/runtime/orchestration/db/automatic-runs/automatic-run-activity-store.ts
new file mode 100644
index 00000000..2250e01b
--- /dev/null
+++ b/src/main/runtime/orchestration/db/automatic-runs/automatic-run-activity-store.ts
@@ -0,0 +1,261 @@
+import type { AutomaticRunWakeRow, DecisionGateRow, TaskRow } from '../../types'
+import { OrchestrationError } from '../../orchestration-error'
+import { generateId } from '../generated-id'
+import type { OrchestrationDb } from '../orchestration-db'
+
+export type AutomaticTaskDeliveryInput = {
+  taskId: string
+  runId: string
+  dispatchId?: string | null
+  outcome: 'succeeded' | 'failed'
+  summary: string
+  evidence: string[]
+  handoff?: string
+  reviewVerdict?: 'approved' | 'changes_requested'
+  codeVersion?: string | null
+}
+
+// A coordinator often answers "Approved, minor notes"; the leading verdict is the decision.
+const REVIEW_RESOLUTION_APPROVED = /^(approved|approve|lgtm)\b/
+
+export function recordAutomaticTaskDelivery(
+  this: OrchestrationDb,
+  delivery: AutomaticTaskDeliveryInput
+): void {
+  if (!this.isAutomaticRun(delivery.runId)) {
+    return
+  }
+  const evidence = JSON.stringify(delivery.evidence)
+  this.db
+    .prepare(
+      `INSERT OR IGNORE INTO task_deliveries (
+         task_id, run_id, dispatch_id, outcome, summary, evidence, handoff,
+         review_verdict, code_version
+       ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`
+    )
+    .run(
+      delivery.taskId,
+      delivery.runId,
+      delivery.dispatchId ?? null,
+      delivery.outcome,
+      delivery.summary,
+      evidence,
+      delivery.handoff ?? null,
+      delivery.reviewVerdict ?? null,
+      delivery.codeVersion ?? null
+    )
+  const stored = this.db
+    .prepare('SELECT * FROM task_deliveries WHERE task_id = ?')
+    .get(delivery.taskId) as Record<string, unknown> | undefined
+  if (!stored) {
+    return
+  }
+  const json = JSON.stringify({
+    outcome: stored.outcome,
+    summary: stored.summary,
+    evidence: JSON.parse(String(stored.evidence)),
+    ...(stored.handoff ? { handoff: stored.handoff } : {}),
+    ...(stored.review_verdict ? { reviewVerdict: stored.review_verdict } : {}),
+    ...(stored.dispatch_id ? { dispatchId: stored.dispatch_id } : {}),
+    ...(stored.code_version ? { codeVersion: stored.code_version } : {}),
+    completedAt: stored.created_at
+  })
+  this.db.prepare('UPDATE tasks SET delivery = ? WHERE id = ?').run(json, delivery.taskId)
+}
+
+export function getTaskDeliveryRow(
+  this: OrchestrationDb,
+  taskId: string
+): Record<string, unknown> | undefined {
+  return this.db.prepare('SELECT * FROM task_deliveries WHERE task_id = ?').get(taskId) as
+    | Record<string, unknown>
+    | undefined
+}
+
+export function createAutomaticRunGate(
+  this: OrchestrationDb,
+  gate: { runId: string; taskId: string; question: string; options?: string[] }
+): DecisionGateRow {
+  const task = this.getTask(gate.taskId)
+  if (!task || task.run_id !== gate.runId) {
+    throw new OrchestrationError(
+      'task_not_found',
+      `Task ${gate.taskId} is not in Run ${gate.runId}.`
+    )
+  }
+  const existing = this.db
+    .prepare("SELECT * FROM decision_gates WHERE task_id = ? AND status = 'pending'")
+    .get(gate.taskId) as DecisionGateRow | undefined
+  if (existing) {
+    return existing
+  }
+  const id = generateId('gate')
+  this.db
+    .prepare(
+      'INSERT INTO decision_gates (id, run_id, task_id, question, options) VALUES (?, ?, ?, ?, ?)'
+    )
+    .run(id, gate.runId, gate.taskId, gate.question, JSON.stringify(gate.options ?? []))
+  return this.db.prepare('SELECT * FROM decision_gates WHERE id = ?').get(id) as DecisionGateRow
+}
+
+export function listPendingGatesForRun(this: OrchestrationDb, runId: string): DecisionGateRow[] {
+  return this.db
+    .prepare(
+      "SELECT * FROM decision_gates WHERE run_id = ? AND status = 'pending' ORDER BY created_at"
+    )
+    .all(runId) as DecisionGateRow[]
+}
+
+export function isApprovedGateResolution(resolution: string): boolean {
+  return REVIEW_RESOLUTION_APPROVED.test(resolution.trim().toLowerCase())
+}
+
+export function recordAutomaticWake(
+  this: OrchestrationDb,
+  wake: { runId: string; eventId: string; eventKey: string; reason: string }
+): AutomaticRunWakeRow {
+  const existing = this.db
+    .prepare('SELECT * FROM automatic_run_wakes WHERE event_key = ?')
+    .get(wake.eventKey) as AutomaticRunWakeRow | undefined
+  if (existing) {
+    return existing
+  }
+  const id = generateId('awake')
+  this.db
+    .prepare(
+      `INSERT INTO automatic_run_wakes (id, run_id, event_id, reason, event_key, status)
+       VALUES (?, ?, ?, ?, ?, 'queued')`
+    )
+    .run(id, wake.runId, wake.eventId, wake.reason, wake.eventKey)
+  return this.db
+    .prepare('SELECT * FROM automatic_run_wakes WHERE id = ?')
+    .get(id) as AutomaticRunWakeRow
+}
+
+export function markAutomaticWakeDelivered(
+  this: OrchestrationDb,
+  wakeId: string,
+  messageId: string | null
+): void {
+  this.db
+    .prepare(
+      `UPDATE automatic_run_wakes
+       SET status = 'delivered', message_id = ?, delivered_at = datetime('now')
+       WHERE id = ? AND status = 'queued'`
+    )
+    .run(messageId, wakeId)
+}
+
+export function listQueuedAutomaticWakes(
+  this: OrchestrationDb,
+  runId: string
+): AutomaticRunWakeRow[] {
+  return this.db
+    .prepare("SELECT * FROM automatic_run_wakes WHERE run_id = ? AND status = 'queued'")
+    .all(runId) as AutomaticRunWakeRow[]
+}
+
+export function hasUnreadAutomaticWake(this: OrchestrationDb, runId: string): boolean {
+  return Boolean(
+    this.db
+      .prepare(
+        `SELECT 1 FROM messages
+         WHERE run_id = ? AND read = 0 AND delivery_contract <> 'audit_only'
+           AND json_extract(payload, '$.automaticRunWake') = 1
+         LIMIT 1`
+      )
+      .get(runId)
+  )
+}
+
+/** Manual starts in an automatic Run share its pause, capacity and decision-gate guarantees. */
+export function assertAutomaticRunAdmitsLaunch(
+  this: OrchestrationDb,
+  runId: string,
+  taskId: string
+): void {
+  const run = this.getRun(runId)
+  if (!run || run.execution_mode !== 'automatic') {
+    return
+  }
+  if (run.execution_state !== 'running') {
+    throw new OrchestrationError(
+      'run_not_running',
+      `Run ${runId} is ${run.execution_state ?? 'not running'}; automatic launches only start while it is running.`
+    )
+  }
+  const active = this.db
+    .prepare(
+      "SELECT COUNT(*) AS count FROM dispatch_contexts WHERE run_id = ? AND status IN ('pending', 'dispatched')"
+    )
+    .get(runId) as { count: number }
+  if (active.count >= run.max_parallel) {
+    throw new OrchestrationError(
+      'capacity_exceeded',
+      `Run ${runId} already has ${active.count} active workers; its parallel limit is ${run.max_parallel}.`
+    )
+  }
+  const task = this.getTask(taskId)
+  if (!task) {
+    return
+  }
+  const gate = this.listPendingGatesForRun(runId).find((row) =>
+    coveredTaskIds(this, task).has(row.task_id)
+  )
+  if (gate) {
+    throw new OrchestrationError(
+      'decision_gate_open',
+      `Run ${runId} has an unresolved decision gate on Task ${gate.task_id}; resolve it before starting ${taskId}.`
+    )
+  }
+}
+
+function coveredTaskIds(db: OrchestrationDb, task: TaskRow): Set<string> {
+  const covered = new Set<string>([task.id])
+  let frontier = [task.id]
+  while (frontier.length > 0) {
+    const next: string[] = []
+    for (const id of frontier) {
+      const row = db.getTask(id)
+      if (!row) {
+        continue
+      }
+      for (const depId of JSON.parse(row.deps) as string[]) {
+        if (!covered.has(depId)) {
+          covered.add(depId)
+          next.push(depId)
+        }
+      }
+    }
+    frontier = next
+  }
+  return covered
+}
+
+export type AutomaticRunActivityStoreMethods = {
+  recordAutomaticTaskDelivery: typeof recordAutomaticTaskDelivery
+  getTaskDeliveryRow: typeof getTaskDeliveryRow
+  createAutomaticRunGate: typeof createAutomaticRunGate
+  listPendingGatesForRun: typeof listPendingGatesForRun
+  isApprovedGateResolution: typeof isApprovedGateResolution
+  recordAutomaticWake: typeof recordAutomaticWake
+  markAutomaticWakeDelivered: typeof markAutomaticWakeDelivered
+  listQueuedAutomaticWakes: typeof listQueuedAutomaticWakes
+  hasUnreadAutomaticWake: typeof hasUnreadAutomaticWake
+  assertAutomaticRunAdmitsLaunch: typeof assertAutomaticRunAdmitsLaunch
+}
+
+export function attachAutomaticRunActivityStore(ctor: { prototype: object }): void {
+  Object.assign(ctor.prototype, {
+    recordAutomaticTaskDelivery,
+    getTaskDeliveryRow,
+    createAutomaticRunGate,
+    listPendingGatesForRun,
+    isApprovedGateResolution,
+    recordAutomaticWake,
+    markAutomaticWakeDelivered,
+    listQueuedAutomaticWakes,
+    hasUnreadAutomaticWake,
+    assertAutomaticRunAdmitsLaunch
+  })
+}
diff --git a/src/main/runtime/orchestration/db/automatic-runs/automatic-run-store.ts b/src/main/runtime/orchestration/db/automatic-runs/automatic-run-store.ts
new file mode 100644
index 00000000..8862009b
--- /dev/null
+++ b/src/main/runtime/orchestration/db/automatic-runs/automatic-run-store.ts
@@ -0,0 +1,183 @@
+import type {
+  AutomaticRunEventRow,
+  RunExecutionOutcome,
+  RunExecutionState,
+  RunRow
+} from '../../types'
+import { generateId } from '../generated-id'
+import type { OrchestrationDb } from '../orchestration-db'
+
+export type AutomaticRunEventInput = {
+  runId: string
+  kind: string
+  eventKey: string
+  taskId?: string | null
+  dispatchId?: string | null
+  payload?: unknown
+}
+
+export function recordAutomaticRunEvent(
+  this: OrchestrationDb,
+  event: AutomaticRunEventInput
+): void {
+  const mode = this.db.prepare('SELECT execution_mode FROM runs WHERE id = ?').get(event.runId) as
+    | { execution_mode: string }
+    | undefined
+  if (mode?.execution_mode !== 'automatic') {
+    return
+  }
+  this.db
+    .prepare(
+      `INSERT OR IGNORE INTO automatic_run_events (
+         id, run_id, task_id, dispatch_id, kind, event_key, payload, state
+       ) VALUES (?, ?, ?, ?, ?, ?, ?, 'pending')`
+    )
+    .run(
+      generateId('aevent'),
+      event.runId,
+      event.taskId ?? null,
+      event.dispatchId ?? null,
+      event.kind,
+      event.eventKey,
+      JSON.stringify(event.payload ?? {})
+    )
+}
+
+/** Called inside a lifecycle transaction; an automatic Run's mutation and its outbox event commit together. */
+export function recordAutomaticRunEventForRun(
+  db: OrchestrationDb,
+  runId: string,
+  event: Omit<AutomaticRunEventInput, 'runId'>
+): void {
+  recordAutomaticRunEvent.call(db, { ...event, runId })
+}
+
+export function isAutomaticRun(this: OrchestrationDb, runId: string): boolean {
+  return (
+    (
+      this.db.prepare('SELECT execution_mode FROM runs WHERE id = ?').get(runId) as
+        | { execution_mode: string }
+        | undefined
+    )?.execution_mode === 'automatic'
+  )
+}
+
+export function listAutomaticRunsForRecovery(this: OrchestrationDb): RunRow[] {
+  return this.db
+    .prepare(
+      `SELECT * FROM runs
+       WHERE execution_mode = 'automatic'
+         AND execution_state IN ('preparing', 'running', 'cancelling')
+       ORDER BY created_at`
+    )
+    .all() as RunRow[]
+}
+
+export function listAutomaticRunsAwaitingFinalReport(this: OrchestrationDb): RunRow[] {
+  return this.db
+    .prepare(
+      `SELECT * FROM runs
+       WHERE execution_mode = 'automatic' AND execution_state = 'settled'
+         AND final_report_delivered_at IS NULL
+       ORDER BY settled_at, created_at`
+    )
+    .all() as RunRow[]
+}
+
+export function setRunExecutionState(
+  this: OrchestrationDb,
+  runId: string,
+  state: RunExecutionState,
+  extra: {
+    outcome?: RunExecutionOutcome | null
+    pauseReason?: string | null
+    cancelReason?: string | null
+    settledAt?: string | null
+    finalReportDeliveredAt?: string | null
+  } = {}
+): boolean {
+  const result = this.db
+    .prepare(
+      `UPDATE runs SET execution_state = ?, execution_outcome = ?,
+         pause_reason = ?, cancel_reason = ?, settled_at = ?,
+         final_report_delivered_at = COALESCE(?, final_report_delivered_at),
+         updated_at = datetime('now')
+       WHERE id = ? AND execution_mode = 'automatic' AND execution_state <> 'settled'`
+    )
+    .run(
+      state,
+      extra.outcome ?? null,
+      extra.pauseReason ?? null,
+      extra.cancelReason ?? null,
+      extra.settledAt ?? null,
+      extra.finalReportDeliveredAt ?? null,
+      runId
+    )
+  return result.changes === 1
+}
+
+export function markRunFinalReportDelivered(
+  this: OrchestrationDb,
+  runId: string,
+  deliveredAt: string
+): void {
+  this.db
+    .prepare(
+      `UPDATE runs SET final_report_delivered_at = COALESCE(final_report_delivered_at, ?),
+         updated_at = datetime('now')
+       WHERE id = ?`
+    )
+    .run(deliveredAt, runId)
+}
+
+export function listPendingAutomaticRunEvents(
+  this: OrchestrationDb,
+  runId: string,
+  limit = 100
+): AutomaticRunEventRow[] {
+  return this.db
+    .prepare(
+      `SELECT * FROM automatic_run_events
+       WHERE run_id = ? AND state = 'pending'
+       ORDER BY created_at, rowid LIMIT ?`
+    )
+    .all(runId, limit) as AutomaticRunEventRow[]
+}
+
+export function markAutomaticRunEventProcessed(
+  this: OrchestrationDb,
+  eventId: string,
+  state: 'processed' | 'failed' = 'processed'
+): void {
+  this.db
+    .prepare(
+      `UPDATE automatic_run_events
+       SET state = ?, attempts = attempts + 1, processed_at = datetime('now')
+       WHERE id = ? AND state = 'pending'`
+    )
+    .run(state, eventId)
+}
+
+export type AutomaticRunStoreMethods = {
+  isAutomaticRun: typeof isAutomaticRun
+  listAutomaticRunsForRecovery: typeof listAutomaticRunsForRecovery
+  listAutomaticRunsAwaitingFinalReport: typeof listAutomaticRunsAwaitingFinalReport
+  setRunExecutionState: typeof setRunExecutionState
+  markRunFinalReportDelivered: typeof markRunFinalReportDelivered
+  recordAutomaticRunEvent: typeof recordAutomaticRunEvent
+  listPendingAutomaticRunEvents: typeof listPendingAutomaticRunEvents
+  markAutomaticRunEventProcessed: typeof markAutomaticRunEventProcessed
+}
+
+export function attachAutomaticRunStore(ctor: { prototype: object }): void {
+  Object.assign(ctor.prototype, {
+    isAutomaticRun,
+    listAutomaticRunsForRecovery,
+    listAutomaticRunsAwaitingFinalReport,
+    setRunExecutionState,
+    markRunFinalReportDelivered,
+    recordAutomaticRunEvent,
+    listPendingAutomaticRunEvents,
+    markAutomaticRunEventProcessed
+  })
+}
diff --git a/src/main/runtime/orchestration/db/automatic-runs/workflow-apply.test.ts b/src/main/runtime/orchestration/db/automatic-runs/workflow-apply.test.ts
new file mode 100644
index 00000000..dd2aee96
--- /dev/null
+++ b/src/main/runtime/orchestration/db/automatic-runs/workflow-apply.test.ts
@@ -0,0 +1,182 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { OrchestrationWorkflow } from '../../../../../shared/orchestration-workflow'
+import { OrchestrationDb } from '../orchestration-db'
+import type { RunRow, TaskRow } from '../../types'
+
+let db: OrchestrationDb
+
+beforeEach(() => {
+  db = new OrchestrationDb(':memory:')
+})
+
+afterEach(() => {
+  db.close()
+})
+
+function run(maxParallel = 2): RunRow {
+  return db.createRun({
+    objective: 'workflow',
+    coordinatorHandle: 'term_coord',
+    coordinatorPaneKey: 'tab:leaf',
+    executionMode: 'automatic',
+    maxParallel,
+    workspaceId: 'wt_main'
+  })
+}
+
+function apply(runId: string, expectedVersion: number, workflow: unknown): void {
+  db.applyOrchestrationWorkflow({
+    runId,
+    expectedVersion,
+    workflow: OrchestrationWorkflow.parse(workflow)
+  })
+}
+
+function tasks(runId: string): TaskRow[] {
+  return db.listTasks({ runId })
+}
+
+describe('applyOrchestrationWorkflow', () => {
+  it('materializes keys into Task ids and bumps the version atomically', () => {
+    const r = run()
+    apply(r.id, 0, {
+      maxParallel: 2,
+      tasks: [
+        { key: 'A', spec: 'Implement A' },
+        { key: 'B', spec: 'Implement B', dependsOn: ['A'] }
+      ]
+    })
+    const a = tasks(r.id).find((task) => task.source_key === 'A') as TaskRow
+    const b = tasks(r.id).find((task) => task.source_key === 'B') as TaskRow
+    expect(a.status).toBe('ready')
+    expect(b.status).toBe('pending')
+    expect(JSON.parse(b.deps)).toEqual([a.id])
+    expect(db.getRun(r.id)).toMatchObject({ workflow_version: 1, max_parallel: 2 })
+  })
+
+  it('updates only not-yet-started Tasks and bumps the version', () => {
+    const r = run()
+    apply(r.id, 0, { tasks: [{ key: 'A', spec: 'old' }] })
+    apply(r.id, 1, { tasks: [{ key: 'A', spec: 'new' }] })
+    expect(tasks(r.id)[0]?.spec).toBe('new')
+    expect(db.getRun(r.id)?.workflow_version).toBe(2)
+  })
+
+  it('refuses to remove or rewrite a started Task', () => {
+    const r = run()
+    apply(r.id, 0, {
+      tasks: [
+        { key: 'A', spec: 'A' },
+        { key: 'B', spec: 'B', dependsOn: ['A'] }
+      ]
+    })
+    const a = tasks(r.id).find((task) => task.source_key === 'A') as TaskRow
+    db.setRunExecutionState(r.id, 'running')
+    db.createStartingWorkerDispatch({
+      taskId: a.id,
+      startOptions: {},
+      creator: { kind: 'system' },
+      maxDepth: 8
+    })
+
+    expect(() => apply(r.id, 1, { tasks: [{ key: 'B', spec: 'B' }] })).toThrow(/already started/)
+    expect(() => apply(r.id, 1, { tasks: [{ key: 'A', spec: 'changed' }] })).toThrow(
+      /only not-yet-started/
+    )
+    expect(db.getRun(r.id)?.workflow_version).toBe(1)
+  })
+
+  it('rejects stale versions without changing the DAG', () => {
+    const r = run()
+    apply(r.id, 0, { tasks: [{ key: 'A', spec: 'A' }] })
+    expect(() => apply(r.id, 0, { tasks: [{ key: 'A', spec: 'other' }] })).toThrow(
+      /Workflow version is 1/
+    )
+    expect(tasks(r.id)[0]?.spec).toBe('A')
+  })
+
+  it('rejects cycles and unknown dependencies before writing rows', () => {
+    const r = run()
+    expect(() =>
+      apply(r.id, 0, {
+        tasks: [
+          { key: 'A', spec: 'A', dependsOn: ['B'] },
+          { key: 'B', spec: 'B', dependsOn: ['A'] }
+        ]
+      })
+    ).toThrow(/cycle/)
+    expect(() =>
+      apply(r.id, 0, {
+        tasks: [{ key: 'A', spec: 'A', dependsOn: ['missing'] }]
+      })
+    ).toThrow(/unknown Task/)
+    expect(tasks(r.id)).toHaveLength(0)
+  })
+
+  it('shares pause, capacity and gate guards with manual starts in an automatic Run', () => {
+    const r = run(1)
+    apply(r.id, 0, { tasks: [{ key: 'A', spec: 'A' }] })
+    const a = tasks(r.id)[0] as TaskRow
+
+    expect(() =>
+      db.createStartingWorkerDispatch({
+        taskId: a.id,
+        startOptions: {},
+        creator: { kind: 'system' },
+        maxDepth: 8
+      })
+    ).toThrow(/preparing/)
+
+    db.setRunExecutionState(r.id, 'running')
+    db.createStartingWorkerDispatch({
+      taskId: a.id,
+      startOptions: {},
+      creator: { kind: 'system' },
+      maxDepth: 8
+    })
+    apply(r.id, 1, {
+      maxParallel: 1,
+      tasks: [
+        { key: 'A', spec: 'A' },
+        { key: 'B', spec: 'B' }
+      ]
+    })
+    const b = tasks(r.id).find((task) => task.source_key === 'B') as TaskRow
+    expect(() =>
+      db.createStartingWorkerDispatch({
+        taskId: b.id,
+        startOptions: {},
+        creator: { kind: 'system' },
+        maxDepth: 8
+      })
+    ).toThrow(/parallel limit/)
+
+    db.completeDispatch(
+      (
+        db.db.prepare('SELECT id FROM dispatch_contexts WHERE task_id = ?').get(a.id) as {
+          id: string
+        }
+      ).id
+    )
+    db.setRunExecutionState(r.id, 'paused')
+    expect(() =>
+      db.createStartingWorkerDispatch({
+        taskId: b.id,
+        startOptions: {},
+        creator: { kind: 'system' },
+        maxDepth: 8
+      })
+    ).toThrow(/paused/)
+  })
+
+  it('keeps manual Runs out of the workflow path', () => {
+    const manual = db.createRun({
+      objective: 'manual',
+      coordinatorHandle: 'term_coord',
+      coordinatorPaneKey: 'tab:leaf'
+    })
+    expect(() => apply(manual.id, 0, { tasks: [{ key: 'A', spec: 'A' }] })).toThrow(
+      /manually operated/
+    )
+  })
+})
diff --git a/src/main/runtime/orchestration/db/automatic-runs/workflow-apply.ts b/src/main/runtime/orchestration/db/automatic-runs/workflow-apply.ts
new file mode 100644
index 00000000..45ee98ff
--- /dev/null
+++ b/src/main/runtime/orchestration/db/automatic-runs/workflow-apply.ts
@@ -0,0 +1,274 @@
+import type { RunRow, TaskRow } from '../../types'
+import { OrchestrationError } from '../../orchestration-error'
+import { buildOrchestrationTaskDisplayMetadata } from '../../../../../shared/orchestration-task-display'
+import type {
+  OrchestrationTaskExecutionOptions,
+  OrchestrationWorkflowInput
+} from '../../../../../shared/orchestration-workflow'
+import { validateOrchestrationWorkflow } from '../../../../../shared/orchestration-workflow'
+import { generateId } from '../generated-id'
+import type { OrchestrationDb } from '../orchestration-db'
+import { recordAutomaticRunEvent } from './automatic-run-store'
+
+export type WorkflowApplyResult = {
+  run: RunRow
+  workflowVersion: number
+  created: number
+  updated: number
+  removed: number
+}
+
+/** Apply a validated workflow atomically; started Tasks are never silently rewritten. */
+export function applyOrchestrationWorkflow(
+  this: OrchestrationDb,
+  params: {
+    runId: string
+    expectedVersion: number
+    workflow: OrchestrationWorkflowInput
+  }
+): WorkflowApplyResult {
+  const problems = validateOrchestrationWorkflow(params.workflow)
+  if (problems.length > 0) {
+    throw new OrchestrationError('invalid_argument', problems.map((p) => p.message).join(' '))
+  }
+  this.db.exec('BEGIN IMMEDIATE')
+  try {
+    const run = this.getRun(params.runId)
+    if (!run) {
+      throw new OrchestrationError('run_not_found', `Run ${params.runId} was not found.`)
+    }
+    if (run.execution_mode !== 'automatic') {
+      throw new OrchestrationError(
+        'invalid_argument',
+        `Run ${params.runId} is manually operated; create it with --mode automatic to apply a workflow.`
+      )
+    }
+    if (run.execution_state === 'settled') {
+      throw new OrchestrationError('run_not_found', `Run ${params.runId} has already settled.`)
+    }
+    if (run.workflow_version !== params.expectedVersion) {
+      throw new OrchestrationError(
+        'workflow_version_conflict',
+        `Workflow version is ${run.workflow_version}, not ${params.expectedVersion}; reload the Run and retry.`
+      )
+    }
+    const workflowKeys = new Map(params.workflow.tasks.map((task) => [task.key, task]))
+    const existing = (
+      this.db
+        .prepare(
+          'SELECT * FROM tasks WHERE run_id = ? AND source_key IS NOT NULL ORDER BY created_at'
+        )
+        .all(params.runId) as TaskRow[]
+    ).map((task) => task)
+    const existingByKey = new Map(existing.map((task) => [task.source_key as string, task]))
+    const idByKey = new Map<string, string>(
+      existing.map((task) => [task.source_key as string, task.id])
+    )
+    let created = 0
+    for (const task of params.workflow.tasks) {
+      if (!idByKey.has(task.key)) {
+        idByKey.set(task.key, generateId('task'))
+        created++
+      }
+    }
+    let updated = 0
+    let removed = 0
+    const removedIds = new Set<string>()
+    for (const task of existing) {
+      if (!workflowKeys.has(task.source_key as string)) {
+        if (task.status !== 'pending' && task.status !== 'ready') {
+          throw new OrchestrationError(
+            'workflow_task_started',
+            `Task ${task.source_key} has already started (${task.status}); stop it before removing it.`
+          )
+        }
+        removedIds.add(task.id)
+        removed++
+      }
+    }
+    for (const task of existing) {
+      const requested = workflowKeys.get(task.source_key as string)
+      if (!requested || removedIds.has(task.id)) {
+        continue
+      }
+      const desiredDeps = JSON.stringify(requested.dependsOn.map((key) => idByKey.get(key)))
+      const nextOptions = JSON.stringify(executionOptionsFor(requested))
+      const started = task.status !== 'pending' && task.status !== 'ready'
+      if (
+        started &&
+        (task.spec !== requested.spec ||
+          task.deps !== desiredDeps ||
+          task.auto_options !== nextOptions ||
+          Boolean(task.needs_coordinator_review) !== requested.review)
+      ) {
+        throw new OrchestrationError(
+          'workflow_task_started',
+          `Task ${task.source_key} is ${task.status}; only not-yet-started Tasks can change.`
+        )
+      }
+      if (!started) {
+        const display = buildOrchestrationTaskDisplayMetadata({
+          spec: requested.spec,
+          taskTitle: requested.title,
+          displayName: requested.displayName
+        })
+        this.db
+          .prepare(
+            `UPDATE tasks SET spec = ?, task_title = ?, display_name = ?, deps = ?,
+               auto_options = ?, review_role = ?, review_of_task_id = ?,
+               needs_coordinator_review = ?
+             WHERE id = ?`
+          )
+          .run(
+            requested.spec,
+            display.taskTitle || null,
+            display.displayName || null,
+            desiredDeps,
+            nextOptions,
+            requested.reviewRole,
+            requested.reviewOf ? (idByKey.get(requested.reviewOf) ?? null) : null,
+            requested.review ? 1 : 0,
+            task.id
+          )
+        updated++
+      }
+    }
+    for (const removedId of removedIds) {
+      const referenced = this.db
+        .prepare(
+          `SELECT 1 FROM tasks
+           WHERE run_id = ? AND id NOT IN (${[...removedIds].map(() => '?').join(',')})
+             AND EXISTS (SELECT 1 FROM json_each(tasks.deps) WHERE value = ?) LIMIT 1`
+        )
+        .get(params.runId, ...removedIds, removedId)
+      if (referenced) {
+        throw new OrchestrationError(
+          'invalid_argument',
+          'A removed Task is still a dependency; remove its dependents in the same workflow update.'
+        )
+      }
+    }
+    for (const removedId of removedIds) {
+      this.db.prepare('DELETE FROM tasks WHERE id = ?').run(removedId)
+    }
+    for (const requested of params.workflow.tasks) {
+      const taskId = idByKey.get(requested.key) as string
+      if (existingByKey.has(requested.key)) {
+        continue
+      }
+      const deps = requested.dependsOn.map((key) => idByKey.get(key) as string)
+      const display = buildOrchestrationTaskDisplayMetadata({
+        spec: requested.spec,
+        taskTitle: requested.title,
+        displayName: requested.displayName
+      })
+      const ready = deps.every((depId) => this.getTask(depId)?.status === 'completed')
+      this.db
+        .prepare(
+          `INSERT INTO tasks (
+             id, run_id, task_title, display_name, spec, status, deps, source_key,
+             auto_options, review_role, review_of_task_id, needs_coordinator_review
+           ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
+        )
+        .run(
+          taskId,
+          params.runId,
+          display.taskTitle || null,
+          display.displayName || null,
+          requested.spec,
+          ready ? 'ready' : 'pending',
+          JSON.stringify(deps),
+          requested.key,
+          JSON.stringify(executionOptionsFor(requested)),
+          requested.reviewRole,
+          requested.reviewOf ? (idByKey.get(requested.reviewOf) ?? null) : null,
+          requested.review ? 1 : 0
+        )
+    }
+    refreshAutomaticTaskReadiness.call(this, params.runId)
+    const workflowVersion = run.workflow_version + 1
+    this.db
+      .prepare(
+        `UPDATE runs SET workflow_version = ?, max_parallel = ?, updated_at = datetime('now')
+         WHERE id = ?`
+      )
+      .run(workflowVersion, params.workflow.maxParallel ?? run.max_parallel, params.runId)
+    recordAutomaticRunEvent.call(this, {
+      runId: params.runId,
+      kind: 'workflow_applied',
+      eventKey: `workflow:${params.runId}:${workflowVersion}`,
+      payload: { created, updated, removed }
+    })
+    this.db.exec('COMMIT')
+    return {
+      run: this.getRun(params.runId) as RunRow,
+      workflowVersion,
+      created,
+      updated,
+      removed
+    }
+  } catch (error) {
+    this.db.exec('ROLLBACK')
+    throw error
+  }
+}
+
+function executionOptionsFor(task: {
+  agent?: string
+  model?: string
+  effort?: string
+  repo?: string
+  worktree?: string
+  workspaceFrom?: string
+  workspaceUsage: 'read' | 'write'
+  timeoutMs?: number
+}): OrchestrationTaskExecutionOptions {
+  return {
+    workspaceUsage: task.workspaceUsage,
+    ...(task.agent ? { agent: task.agent } : {}),
+    ...(task.model ? { model: task.model } : {}),
+    ...(task.effort ? { effort: task.effort } : {}),
+    ...(task.repo ? { repo: task.repo } : {}),
+    ...(task.worktree ? { worktree: task.worktree } : {}),
+    ...(task.workspaceFrom ? { workspaceFrom: task.workspaceFrom } : {}),
+    ...(task.timeoutMs ? { timeoutMs: task.timeoutMs } : {})
+  }
+}
+
+/** Promotion is by dependency completion; a workflow apply runs it for rows it did not touch. */
+export function refreshAutomaticTaskReadiness(this: OrchestrationDb, runId: string): void {
+  const tasks = this.db
+    .prepare(
+      "SELECT id, status, deps FROM tasks WHERE run_id = ? AND status IN ('pending', 'ready')"
+    )
+    .all(runId) as Pick<TaskRow, 'id' | 'status' | 'deps'>[]
+  const statusById = new Map(
+    (
+      this.db.prepare('SELECT id, status FROM tasks WHERE run_id = ?').all(runId) as Pick<
+        TaskRow,
+        'id' | 'status'
+      >[]
+    ).map((task) => [task.id, task.status])
+  )
+  for (const task of tasks) {
+    const deps: string[] = JSON.parse(task.deps)
+    const ready = deps.every((depId) => statusById.get(depId) === 'completed')
+    const next = ready ? 'ready' : 'pending'
+    if (next !== task.status) {
+      this.db.prepare('UPDATE tasks SET status = ? WHERE id = ?').run(next, task.id)
+      statusById.set(task.id, next)
+    }
+  }
+}
+
+export type WorkflowApplyMethods = {
+  applyOrchestrationWorkflow: typeof applyOrchestrationWorkflow
+  refreshAutomaticTaskReadiness: typeof refreshAutomaticTaskReadiness
+}
+
+export function attachWorkflowApply(ctor: { prototype: object }): void {
+  Object.assign(ctor.prototype, {
+    applyOrchestrationWorkflow,
+    refreshAutomaticTaskReadiness
+  })
+}
