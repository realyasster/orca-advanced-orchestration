+  recordAutomaticRunEvent
+} from '../db/automatic-runs/automatic-run-store'
+import {
+  afterGateResolved,
+  afterTaskCompleted,
+  parseJson,
+  pendingGateAttention,
+  type AttentionEvent
+} from './automatic-run-review'
+import { handleAutomaticEventFailure } from './automatic-run-event-failure'
+import { activeDispatches, launchReadyTasks } from './automatic-run-launch'
+import { recoverFinalReports, settleIfFinished, settleRun } from './automatic-run-settlement'
+
+export type AutomaticLaunchRequest = {
+  run: RunRow
+  task: TaskRow
+  options: OrchestrationTaskExecutionOptions
+  worktree: string | undefined
+  workspaceKey: string | null
+}
+
+export type AutomaticLaunchResult = {
+  dispatchId?: string
+  worktreeId?: string
+  error?: string
+}
+
+export type AutomaticRunHost = {
+  launchTask(request: AutomaticLaunchRequest): Promise<AutomaticLaunchResult>
+  stopDispatch(dispatchId: string): Promise<{ state: string; stopped: boolean; reason?: string }>
+  notifyRun(runId: string): void
+}
+
+const AUTOMATIC_RUN_SENDER = 'orca:auto'
+
+/**
+ * Event-driven scheduler for opt-in automatic Runs. It holds no timer and calls no model:
+ * lifecycle transactions enqueue outbox rows, and this executor advances the DAG.
+ */
+export class AutomaticRunExecutor {
+  private readonly activeRuns = new Map<string, Promise<void>>()
+  private readonly rerunRequested = new Set<string>()
+
+  constructor(
+    private readonly db: OrchestrationDb,
+    private readonly host: AutomaticRunHost
+  ) {}
+
+  /** Startup reconciliation: replay pending outbox rows, verify launch state, then resume safe work. */
+  recover(): void {
+    for (const run of this.db.listAutomaticRunsForRecovery()) {
+      if (run.execution_state !== 'cancelling') {
+        this.reconcileInterruptedLaunches(run)
+      }
+      this.trigger(run.id)
+    }
+    recoverFinalReports(this.db, this.host)
+  }
+
+  /** Tests and callers that need a deterministic hand-off wait for the current loop to drain. */
+  async drain(runId: string): Promise<void> {
+    for (let guard = 0; guard < 20; guard++) {
+      const active = this.activeRuns.get(runId)
+      if (!active) {
+        return
+      }
+      await active
+    }
+  }
+
+  trigger(runId: string): void {
+    if (this.activeRuns.has(runId)) {
+      this.rerunRequested.add(runId)
+      return
+    }
+    const run = this.runLoop(runId)
+    this.activeRuns.set(runId, run)
+    void run.finally(() => {
+      this.activeRuns.delete(runId)
+      if (this.rerunRequested.delete(runId)) {
+        this.trigger(runId)
+      }
+    })
+  }
+
+  private async runLoop(runId: string): Promise<void> {
+    do {
+      this.rerunRequested.delete(runId)
+      try {
+        await this.tick(runId)
+      } catch (error) {
+        console.warn('[automatic-run] tick failed', runId, error)
+      }
+    } while (this.rerunRequested.has(runId))
+  }
+
+  private async tick(runId: string): Promise<void> {
+    const run = this.db.getRun(runId)
+    if (!run || run.execution_mode !== 'automatic' || run.execution_state === 'settled') {
+      return
+    }
+    if (run.execution_state === 'cancelling') {
+      await this.cancelRun(run)
+      return
+    }
+    if (run.execution_state !== 'running') {
+      return
+    }
+    this.processPendingEvents(run, this.db.listPendingAutomaticRunEvents(run.id))
+    const refreshed = this.db.getRun(runId) as RunRow
+    this.deliverWakes(refreshed, pendingGateAttention(this.db, refreshed))
+    if (this.db.getRun(runId)?.execution_state !== 'running') {
+      return
+    }
+    await launchReadyTasks(this.db, this.host, refreshed)
+    settleIfFinished(
+      this.db,
+      this.host,
+      this.db.getRun(runId) as RunRow,
+      activeDispatches(this.db, runId).length
+    )
+  }
+
+  private processPendingEvents(run: RunRow, events: AutomaticRunEventRow[]): void {
+    for (const event of events) {
+      // Apply, persist the wake, and mark the event processed as one durable unit.
+      this.db.db.exec('BEGIN IMMEDIATE')
+      try {
+        this.applyEvent(run.id, event)
+        for (const item of this.eventAttention([event])) {
+          this.db.recordAutomaticWake({
+            runId: run.id,
+            eventId: item.eventId,
+            eventKey: item.eventKey,
+            reason: item.reason
+          })
+        }
+        markAutomaticRunEventProcessed.call(this.db, event.id)
+        this.db.db.exec('COMMIT')
+      } catch (error) {
+        this.db.db.exec('ROLLBACK')
+        console.warn('[automatic-run] event failed', run.id, event.kind, error)
+        handleAutomaticEventFailure(this.db, run, event, error)
+      }
+    }
+  }
+
+  private applyEvent(runId: string, event: AutomaticRunEventRow): void {
+    const task = event.task_id ? this.db.getTask(event.task_id) : undefined
+    if (event.kind === 'task_completed') {
+      afterTaskCompleted(this.db, runId, task)
+    } else if (event.kind === 'gate_resolved') {
+      afterGateResolved(this.db, runId, event)
+    }
+  }
+
+  private eventAttention(events: AutomaticRunEventRow[]): AttentionEvent[] {
+    const attention: AttentionEvent[] = []
+    for (const event of events) {
+      if (
+        !['task_failed', 'launch_failed', 'launch_unknown', 'invalid_completion'].includes(
+          event.kind
+        )
+      ) {
+        continue
+      }
+      const task = event.task_id ? this.db.getTask(event.task_id) : undefined
+      const label = task?.task_title ?? task?.display_name ?? event.task_id ?? event.kind
+      const payload = parseJson(event.payload)
+      const report = typeof payload.result === 'string' ? parseJson(payload.result) : {}
+      const detail = eventDetail(payload, report, event.kind)
+      attention.push({
+        eventId: event.id,
+        eventKey: `wake:${event.id}`,
+        reason: `${label}: ${detail}`
+      })
+    }
+    return attention
+  }
+
+  private deliverWakes(run: RunRow, attention: AttentionEvent[], force = false): void {
+    // Record every attention event first, even while an earlier wake is unread, so it is not lost.
+    for (const item of attention) {
+      this.db.recordAutomaticWake({
+        runId: run.id,
+        eventId: item.eventId,
+        eventKey: item.eventKey,
+        reason: item.reason
+      })
+    }
+    // One unread wake summarizes everything pending; queued rows wait for that check.
+    if (!force && this.db.hasUnreadAutomaticWake(run.id)) {
+      return
+    }
+    const queued: AutomaticRunWakeRow[] = []
+    for (const wake of this.db.listQueuedAutomaticWakes(run.id)) {
+      if (!queued.some((row) => row.id === wake.id)) {
+        queued.push(wake)
+      }
+    }
+    if (queued.length === 0) {
+      return
+    }
+    const message = this.db.insertMessage({
+      from: AUTOMATIC_RUN_SENDER,
+      to: `run:${run.id}`,
+      subject: `Automatic Run ${run.id} needs a decision`,
+      body: queued.map((wake) => wake.reason).join('\n'),
+      type: 'decision_gate',
+      priority: 'high',
+      runId: run.id,
+      payload: JSON.stringify({
+        automaticRunWake: true,
+        runId: run.id,
+        reasons: queued.map((wake) => wake.reason),
+        eventKeys: queued.map((wake) => wake.event_key)
+      })
+    })
+    for (const wake of queued) {
+      this.db.markAutomaticWakeDelivered(wake.id, message.id)
+    }
+    this.host.notifyRun(run.id)
+  }
+
+  private async cancelRun(run: RunRow): Promise<void> {
+    const active = activeDispatches(this.db, run.id)
+    if (active.length === 0) {
+      settleRun(this.db, this.host, run, 'cancelled')
+      return
+    }
+    let allStopped = true
+    for (const dispatch of active) {
+      const result = await this.host.stopDispatch(dispatch.id)
+      if (!result.stopped) {
+        allStopped = false
+      }
+    }
+    if (allStopped && activeDispatches(this.db, run.id).length === 0) {
+      settleRun(this.db, this.host, run, 'cancelled')
+    } else {
+      this.deliverWakes(
+        run,
+        [
+          {
+            eventId: 'cancel-unknown',
+            eventKey: `cancel_unknown:${run.id}`,
+            reason:
+              'Cancel is waiting: at least one worker stop could not be proven (stop_unknown). The Run is not reported as cancelled.'
+          }
+        ],
+        true
+      )
+    }
+  }
+
+  private reconcileInterruptedLaunches(run: RunRow): void {
+    const rows = this.db.db
+      .prepare(
+        `SELECT d.* FROM dispatch_contexts d
+         JOIN worker_dispatches w ON w.dispatch_id = d.id
+         WHERE d.run_id = ? AND d.status IN ('pending', 'dispatched')
+           AND w.state = 'starting' AND w.agent_terminal_handle IS NULL`
+      )
+      .all(run.id) as DispatchContextRow[]
+    for (const row of rows) {
+      if (this.db.getTask(row.task_id)?.status !== 'dispatched') {
+        continue
+      }
+      this.db.markWorkerStartUnknown(
+        row.id,
+        'start_unknown',
+        'Orca restarted before the worker launch was observed.'
+      )
+      recordAutomaticRunEvent.call(this.db, {
+        runId: run.id,
+        kind: 'launch_unknown',
+        eventKey: `launch_unknown:${row.id}`,
+        taskId: row.task_id,
+        dispatchId: row.id,
+        payload: { reason: 'runtime_restarted_before_observation' }
+      })
+    }
+  }
+}
+
+function eventDetail(
+  payload: Record<string, unknown>,
+  report: Record<string, unknown>,
+  kind: string
+): string {
+  if (typeof payload.error === 'string') {
+    return payload.error
+  }
+  if (typeof payload.reason === 'string') {
+    return payload.reason
+  }
+  return typeof report.summary === 'string' ? report.summary : kind
+}
diff --git a/src/main/runtime/orchestration/automatic-run/automatic-run-launch.ts b/src/main/runtime/orchestration/automatic-run/automatic-run-launch.ts
new file mode 100644
index 00000000..15a119b3
--- /dev/null
+++ b/src/main/runtime/orchestration/automatic-run/automatic-run-launch.ts
@@ -0,0 +1,178 @@
+import type { DispatchContextRow, RunRow, TaskRow } from '../types'
+import { executionOptionsOfTask } from '../../../../shared/orchestration-workflow'
+import type { OrchestrationDb } from '../db'
+import { recordAutomaticRunEvent } from '../db/automatic-runs/automatic-run-store'
+import type { AutomaticLaunchResult, AutomaticRunHost } from './automatic-run-executor'
+import { dependencyClosure, resolveWorkspace, workspaceConflicts } from './automatic-run-workspace'
+
+export function activeDispatches(db: OrchestrationDb, runId: string): DispatchContextRow[] {
+  return db.db
+    .prepare(
+      `SELECT * FROM dispatch_contexts
+       WHERE run_id = ? AND status IN ('pending', 'dispatched')
+       ORDER BY rowid`
+    )
+    .all(runId) as DispatchContextRow[]
+}
+
+export async function launchReadyTasks(
+  db: OrchestrationDb,
+  host: AutomaticRunHost,
+  run: RunRow
+): Promise<void> {
+  const tasks = db.listTasks({ runId: run.id })
+  const active = activeDispatches(db, run.id)
+  let slots = run.max_parallel - active.length
+  if (slots <= 0) {
+    return
+  }
+  const pendingGateTasks = new Set(db.listPendingGatesForRun(run.id).map((gate) => gate.task_id))
+  const activeWorkspaces = new Set<string>()
+  const activeWriteWorkspaces = new Set<string>()
+  for (const dispatch of active) {
+    const task = db.getTask(dispatch.task_id)
+    const workspaceKey = task?.resolved_worktree_id
+    if (!task || !workspaceKey) {
+      continue
+    }
+    activeWorkspaces.add(workspaceKey)
+    if (executionOptionsOfTask(task).workspaceUsage === 'write') {
+      activeWriteWorkspaces.add(workspaceKey)
+    }
+  }
+  const ready = tasks.filter((task) => task.status === 'ready')
+  const readyWriteCount = ready.filter(
+    (task) => executionOptionsOfTask(task).workspaceUsage === 'write'
+  ).length
+  for (const queuedTask of ready) {
+    if (slots <= 0) {
+      break
+    }
+    // A workflow update during this tick must not launch the pre-update spec.
+    const freshRun = db.getRun(run.id)
+    if (!freshRun || freshRun.workflow_version !== run.workflow_version) {
+      break
+    }
+    const task = db.getTask(queuedTask.id)
+    if (!task || task.status !== 'ready' || !canLaunch(db, task, pendingGateTasks, active)) {
+      continue
+    }
+    const options = executionOptionsOfTask(task)
+    const target = resolveWorkspace(db, freshRun, task, options, readyWriteCount > 1)
+    if (
+      target === 'wait' ||
+      (target.workspaceKey &&
+        workspaceConflicts(
+          options.workspaceUsage,
+          target.workspaceKey,
+          activeWorkspaces,
+          activeWriteWorkspaces
+        ))
+    ) {
+      continue
+    }
+    slots--
+    const result = await launchOne(
+      db,
+      host,
+      freshRun,
+      task,
+      options,
+      target.selector,
+      target.workspaceKey
+    )
+    if (result.error || result.failed) {
+      slots++
+      continue
+    }
+    if (target.workspaceKey) {
+      activeWorkspaces.add(target.workspaceKey)
+      if (options.workspaceUsage === 'write') {
+        activeWriteWorkspaces.add(target.workspaceKey)
+      }
+    }
+    if (result.worktreeId) {
+      db.db
+        .prepare('UPDATE tasks SET resolved_worktree_id = ? WHERE id = ?')
+        .run(result.worktreeId, task.id)
+    }
+  }
+}
+
+async function launchOne(
+  db: OrchestrationDb,
+  host: AutomaticRunHost,
+  run: RunRow,
+  task: TaskRow,
+  options: ReturnType<typeof executionOptionsOfTask>,
+  worktree: string | undefined,
+  workspaceKey: string | null
+): Promise<AutomaticLaunchResult & { failed?: boolean }> {
+  try {
+    const result = await host.launchTask({ run, task, options, worktree, workspaceKey })
+    if (!result.error) {
+      return result
+    }
+    await recordLaunchError(db, run, task, result.error)
+    return { ...result, failed: true }
+  } catch (error) {
+    await recordLaunchError(db, run, task, error instanceof Error ? error.message : String(error))
+    return { error: 'launch threw', failed: true }
+  }
+}
+
+async function recordLaunchError(
+  db: OrchestrationDb,
+  run: RunRow,
+  task: TaskRow,
+  message: string
+): Promise<void> {
+  db.db
+    .prepare("UPDATE tasks SET status = 'blocked' WHERE id = ? AND status = 'ready'")
+    .run(task.id)
+  recordAutomaticRunEvent.call(db, {
+    runId: run.id,
+    kind: 'launch_failed',
+    eventKey: `launch_error:${task.id}:${Date.now()}`,
+    taskId: task.id,
+    payload: { error: message }
+  })
+}
+
+/** A gate on a review/correction task holds everyone waiting on the Task it reviews. */
+function gateBlocksClosure(db: OrchestrationDb, gateTaskId: string, closure: Set<string>): boolean {
+  if (closure.has(gateTaskId)) {
+    return true
+  }
+  const gateTask = db.getTask(gateTaskId)
+  return Boolean(gateTask?.review_of_task_id && closure.has(gateTask.review_of_task_id))
+}
+
+function canLaunch(
+  db: OrchestrationDb,
+  task: TaskRow,
+  pendingGateTasks: Set<string>,
+  active: DispatchContextRow[]
+): boolean {
+  if (active.some((dispatch) => dispatch.task_id === task.id)) {
+    return false
+  }
+  const deps = JSON.parse(task.deps) as string[]
+  if (!deps.every((depId) => db.getTask(depId)?.status === 'completed')) {
+    return false
+  }
+  const closure = dependencyClosure(db, task)
+  if ([...pendingGateTasks].some((id) => gateBlocksClosure(db, id, closure))) {
+    return false
+  }
+  // A failed review/correction is a waiting branch, not an approval: only completed closes it.
+  return !db
+    .listTasks({ runId: task.run_id })
+    .some(
+      (candidate) =>
+        candidate.id !== task.id &&
+        candidate.review_of_task_id !== null &&
+        closure.has(candidate.review_of_task_id) &&
+        candidate.status !== 'completed'
+    )
+}
diff --git a/src/main/runtime/orchestration/automatic-run/automatic-run-review.ts b/src/main/runtime/orchestration/automatic-run/automatic-run-review.ts
new file mode 100644
index 00000000..27700614
--- /dev/null
+++ b/src/main/runtime/orchestration/automatic-run/automatic-run-review.ts
@@ -0,0 +1,148 @@
+import type { AutomaticRunEventRow, RunRow, TaskRow } from '../types'
+import {
+  deliveryOfTask,
+  executionOptionsOfTask,
+  type OrchestrationTaskExecutionOptions
+} from '../../../../shared/orchestration-workflow'
+import { buildOrchestrationTaskDisplayMetadata } from '../../../../shared/orchestration-task-display'
+import {
+  createAutomaticRunGate,
+  isApprovedGateResolution
+} from '../db/automatic-runs/automatic-run-activity-store'
+import { recordAutomaticRunEvent } from '../db/automatic-runs/automatic-run-store'
+import type { OrchestrationDb } from '../db'
+
+export type AttentionEvent = {
+  eventId: string
+  eventKey: string
+  reason: string
+}
+
+export function afterTaskCompleted(db: OrchestrationDb, runId: string, task?: TaskRow): void {
+  if (!task) {
+    return
+  }
+  if (task.review_role === 'review' || task.needs_coordinator_review === 1) {
+    openReviewGate(db, runId, task)
+  }
+}
+
+function openReviewGate(db: OrchestrationDb, runId: string, task: TaskRow): void {
+  const reviewed = task.review_of_task_id ? db.getTask(task.review_of_task_id) : undefined
+  const target = reviewed ?? task
+  const label =
+    buildOrchestrationTaskDisplayMetadata({
+      spec: target.spec,
+      taskTitle: target.task_title,
+      displayName: target.display_name
+    }).taskTitle || target.id
+  const verdict = deliveryOfTask(task)?.reviewVerdict
+  const gate = createAutomaticRunGate.call(db, {
+    runId,
+    taskId: task.id,
+    question:
+      task.review_role === 'review'
+        ? `Review the result of "${label}" and answer approved or changes_requested.${verdict ? ` The reviewer reported ${verdict}.` : ''}`
+        : `Review the completed Task "${label}" and answer approved or changes_requested.`,
+    options: ['approved', 'changes_requested']
+  })
+  recordAutomaticRunEvent.call(db, {
+    runId,
+    kind: 'gate_opened',
+    eventKey: `gate_opened:${gate.id}`,
+    taskId: task.id,
+    dispatchId: null,
+    payload: { gateId: gate.id, question: gate.question }
+  })
+}
+
+export function afterGateResolved(
+  db: OrchestrationDb,
+  runId: string,
+  event: AutomaticRunEventRow
+): void {
+  const payload = parseJson(event.payload)
+  const gateId = typeof payload.gateId === 'string' ? payload.gateId : null
+  const resolution = typeof payload.resolution === 'string' ? payload.resolution : ''
+  if (!gateId || isApprovedGateResolution(resolution)) {
+    return
+  }
+  const gate = db.getGate(gateId)
+  if (!gate) {
+    return
+  }
+  const task = db.getTask(gate.task_id)
+  if (!task || task.correction_round >= 2) {
+    createAutomaticRunGate.call(db, {
+      runId,
+      taskId: task?.id ?? gate.task_id,
+      question: `Correction limit reached for "${task?.task_title ?? gate.task_id}". Resolve manually with approved or changes_requested, or edit the workflow.`,
+      options: ['approved', 'changes_requested']
+    })
+    return
+  }
+  const round = task.correction_round + 1
+  const reviewedTask =
+    task.review_role === 'review' && task.review_of_task_id
+      ? db.getTask(task.review_of_task_id)
+      : task
+  const reviewSource = task.review_role === 'review' ? task : undefined
+  const correction = db.createTask({
+    runId,
+    spec: `Address the review findings for "${reviewedTask?.task_title ?? task.task_title ?? task.id}":\n\n${resolution}`,
+    taskTitle: `Correction ${round}: ${reviewedTask?.task_title ?? task.task_title ?? task.id}`,
+    deps: [task.id],
+    autoOptions: JSON.stringify(
+      executionOptionsOfTask(task) satisfies OrchestrationTaskExecutionOptions
+    ),
+    reviewRole: 'correction',
+    reviewOfTaskId: reviewedTask?.id ?? task.id,
+    correctionRound: round,
+    needsCoordinatorReview: !reviewSource
+  })
+  db.db
+    .prepare('UPDATE tasks SET resolved_worktree_id = ? WHERE id = ?')
+    .run(task.resolved_worktree_id, correction.id)
+  if (reviewSource) {
+    const reReview = db.createTask({
+      runId,
+      spec: reviewSource.spec,
+      taskTitle: `Re-review ${round}: ${reviewedTask?.task_title ?? reviewSource.id}`,
+      deps: [correction.id],
+      autoOptions: reviewSource.auto_options,
+      reviewRole: 'review',
+      reviewOfTaskId: reviewedTask?.id ?? task.id,
+      correctionRound: round
+    })
+    db.db
+      .prepare('UPDATE tasks SET resolved_worktree_id = ? WHERE id = ?')
+      .run(task.resolved_worktree_id, reReview.id)
+  }
+}
+
+export function pendingGateAttention(db: OrchestrationDb, run: RunRow): AttentionEvent[] {
+  return db
+    .listPendingGatesForRun(run.id)
+    .filter(
+      (gate) =>
+        !db.db
+          .prepare('SELECT 1 FROM automatic_run_wakes WHERE event_key = ?')
+          .get(`gate_opened:${gate.id}`)
+    )
+    .map((gate) => ({
+      eventId: gate.id,
+      eventKey: `gate_opened:${gate.id}`,
+      reason: `Decision gate: ${gate.question} (gate ${gate.id})`
+    }))
+}
+
+export function parseJson(value: string): Record<string, unknown> {
+  try {
+    const parsed: unknown = JSON.parse(value)
+    return parsed && typeof parsed === 'object' && !Array.isArray(parsed)
+      ? (parsed as Record<string, unknown>)
+      : {}
+  } catch {
+    return {}
+  }
+}
diff --git a/src/main/runtime/orchestration/automatic-run/automatic-run-settlement.ts b/src/main/runtime/orchestration/automatic-run/automatic-run-settlement.ts
new file mode 100644
index 00000000..ee8427f1
--- /dev/null
+++ b/src/main/runtime/orchestration/automatic-run/automatic-run-settlement.ts
@@ -0,0 +1,131 @@
+import type { RunExecutionOutcome, RunRow } from '../types'
+import { deliveryOfTask } from '../../../../shared/orchestration-workflow'
+import type { OrchestrationDb } from '../db'
+import type { AutomaticRunHost } from './automatic-run-executor'
+import { recordAutomaticWake } from '../db/automatic-runs/automatic-run-activity-store'
+
+/** A failed branch waits for a coordinator decision; only an all-completed Run settles itself. */
+export function settleIfFinished(
+  db: OrchestrationDb,
+  host: AutomaticRunHost,
+  run: RunRow,
+  activeCount: number
+): void {
+  if (run.execution_state !== 'running') {
+    return
+  }
+  if (db.listPendingAutomaticRunEvents(run.id).length > 0 || activeCount > 0) {
+    return
+  }
+  if (db.listPendingGatesForRun(run.id).length > 0) {
+    return
+  }
+  const tasks = db.listTasks({ runId: run.id })
+  if (tasks.length === 0 || !tasks.every((task) => task.status === 'completed')) {
+    return
+  }
+  settleRun(db, host, run, 'completed')
+}
+
+export function settleRun(
+  db: OrchestrationDb,
+  host: AutomaticRunHost,
+  run: RunRow,
+  outcome: RunExecutionOutcome
+): void {
+  const current = db.getRun(run.id)
+  if (!current) {
+    return
+  }
+  let created = false
+  db.db.exec('BEGIN IMMEDIATE')
+  try {
+    if (current.execution_state === 'settled') {
+      if (!current.final_report_delivered_at) {
+        created = writeFinalReport(db, run.id)
+      }
+      db.db.exec('COMMIT')
+    } else {
+      if (
+        db.setRunExecutionState(run.id, 'settled', { outcome, settledAt: new Date().toISOString() })
+      ) {
+        created = writeFinalReport(db, run.id)
+      }
+      db.db.exec('COMMIT')
+    }
+  } catch (error) {
+    db.db.exec('ROLLBACK')
+    throw error
+  }
+  if (created) {
+    host.notifyRun(run.id)
+  }
+}
+
+/** Rebuild a report lost between marking the Run settled and delivering its wake. */
+export function recoverFinalReports(db: OrchestrationDb, host: AutomaticRunHost): void {
+  for (const run of db.listAutomaticRunsAwaitingFinalReport()) {
+    let created = false
+    db.db.exec('BEGIN IMMEDIATE')
+    try {
+      created = writeFinalReport(db, run.id)
+      db.db.exec('COMMIT')
+    } catch (error) {
+      db.db.exec('ROLLBACK')
+      throw error
+    }
+    if (created) {
+      host.notifyRun(run.id)
+    }
+  }
+}
+
+function writeFinalReport(db: OrchestrationDb, runId: string): boolean {
+  const current = db.getRun(runId)
+  if (!current || current.final_report_delivered_at) {
+    return false
+  }
+  const tasks = db.listTasks({ runId })
+  const completed = tasks.filter((task) => task.status === 'completed').length
+  const failed = tasks.filter((task) => task.status === 'failed').length
+  const pending = tasks.length - completed - failed
+  const outcome = current.execution_outcome ?? 'failed'
+  const body = [
+    `Automatic Run ${runId} settled: ${outcome}.`,
+    `Tasks: ${completed} completed, ${failed} failed, ${pending} not completed.`,
+    ...tasks.map((task) => {
+      const delivery = deliveryOfTask(task)
+      const label = task.task_title ?? task.display_name ?? task.id
+      return `- ${label} [${task.status}]${delivery ? `: ${delivery.summary}` : ''}`
+    })
+  ].join('\n')
+  const wake = recordAutomaticWake.call(db, {
+    runId,
+    eventId: 'final-report',
+    eventKey: `settled:${runId}`,
+    reason: body
+  })
+  if (wake.status === 'delivered' && wake.message_id) {
+    if (db.getMessageById(wake.message_id)) {
+      db.markRunFinalReportDelivered(runId, new Date().toISOString())
+      return false
+    }
+    // The message was removed with older rows; re-open the wake so the report can be delivered.
+    db.db
+      .prepare("UPDATE automatic_run_wakes SET status = 'queued', message_id = NULL WHERE id = ?")
+      .run(wake.id)
+  }
+  const message = db.insertMessage({
+    from: 'orca:auto',
+    to: `run:${runId}`,
+    subject: `Automatic Run ${runId} final report`,
+    body,
+    type: 'status',
+    priority: 'normal',
+    runId,
+    payload: JSON.stringify({ automaticRunWake: true, runId, finalReport: true })
+  })
+  db.markAutomaticWakeDelivered(wake.id, message.id)
+  db.markRunFinalReportDelivered(runId, message.created_at)
+  return true
+}
