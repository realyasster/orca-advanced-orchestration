--- /dev/null
+++ b/src/main/runtime/orchestration/automatic-run/automatic-run-task-brief.ts
@@ -0,0 +1,48 @@
+import type { OrchestrationDb } from '../db'
+import type { TaskRow } from '../types'
+import { deliveryOfTask } from '../../../../shared/orchestration-workflow'
+
+const MAX_BRIEF_CHARS = 8000
+
+/**
+ * Deterministic handoff package: the worker gets its own spec plus direct dependency
+ * deliveries and accepted decisions, never the whole chat or terminal transcript.
+ */
+export function automaticTaskBrief(db: OrchestrationDb, task: TaskRow): string {
+  const deps = (JSON.parse(task.deps) as string[])
+    .map((id) => db.getTask(id))
+    .filter((dep): dep is TaskRow => Boolean(dep))
+  if (deps.length === 0) {
+    return task.spec
+  }
+  const sections = ['--- AUTOMATIC RUN CONTEXT (from durable records) ---']
+  for (const dep of deps) {
+    const delivery = deliveryOfTask(dep)
+    const label = dep.task_title ?? dep.display_name ?? dep.id
+    sections.push(`Dependency: ${label} [${dep.status}]`)
+    if (delivery) {
+      if (delivery.summary) {
+        sections.push(`  Result: ${delivery.summary}`)
+      }
+      if (delivery.evidence.length > 0) {
+        sections.push(`  Evidence: ${delivery.evidence.join(', ')}`)
+      }
+      if (delivery.handoff) {
+        sections.push(`  Handoff: ${delivery.handoff}`)
+      }
+    }
+    if (dep.resolved_worktree_id) {
+      sections.push(`  Workspace: ${dep.resolved_worktree_id}`)
+    }
+    for (const gate of db.listGates({ taskId: dep.id, status: 'resolved' })) {
+      if (gate.resolution) {
+        sections.push(`  Decision: ${gate.question} -> ${gate.resolution}`)
+      }
+    }
+  }
+  sections.push(
+    'Use the dependency results above as the starting point; do not repeat completed work.'
+  )
+  const suffix = `\n\n${sections.join('\n')}`
+  return `${task.spec.slice(0, Math.max(0, MAX_BRIEF_CHARS - suffix.length))}${suffix}`
+}
diff --git a/src/main/runtime/orchestration/automatic-run/automatic-run-workspace.ts b/src/main/runtime/orchestration/automatic-run/automatic-run-workspace.ts
new file mode 100644
index 00000000..369c5c76
--- /dev/null
+++ b/src/main/runtime/orchestration/automatic-run/automatic-run-workspace.ts
@@ -0,0 +1,83 @@
+import type { RunRow, TaskRow } from '../types'
+import type { OrchestrationTaskExecutionOptions } from '../../../../shared/orchestration-workflow'
+import type { OrchestrationDb } from '../db'
+
+export type WorkspaceTarget = { selector: string | undefined; workspaceKey: string | null } | 'wait'
+
+export function dependencyClosure(db: OrchestrationDb, task: TaskRow): Set<string> {
+  const closure = new Set<string>()
+  const queue = [task.id]
+  while (queue.length > 0) {
+    const id = queue.shift() as string
+    const row = db.getTask(id)
+    if (!row) {
+      continue
+    }
+    for (const depId of JSON.parse(row.deps) as string[]) {
+      if (!closure.has(depId)) {
+        closure.add(depId)
+        queue.push(depId)
+      }
+    }
+  }
+  return closure
+}
+
+export function resolveWorkspace(
+  db: OrchestrationDb,
+  run: RunRow,
+  task: TaskRow,
+  options: OrchestrationTaskExecutionOptions,
+  simultaneousWriteBatch: boolean
+): WorkspaceTarget {
+  // A review must see the implementation's exact code version.
+  if (!options.workspaceFrom && task.review_of_task_id) {
+    const reviewed = db.getTask(task.review_of_task_id)
+    if (reviewed?.resolved_worktree_id) {
+      return {
+        selector: `id:${reviewed.resolved_worktree_id}`,
+        workspaceKey: reviewed.resolved_worktree_id
+      }
+    }
+  }
+  if (options.workspaceFrom) {
+    const source = db.db
+      .prepare('SELECT * FROM tasks WHERE run_id = ? AND source_key = ?')
+      .get(run.id, options.workspaceFrom) as TaskRow | undefined
+    if (!source?.resolved_worktree_id) {
+      return 'wait'
+    }
+    return {
+      selector: `id:${source.resolved_worktree_id}`,
+      workspaceKey: source.resolved_worktree_id
+    }
+  }
+  if (options.worktree?.startsWith('id:')) {
+    return { selector: options.worktree, workspaceKey: options.worktree.slice(3) }
+  }
+  if (options.worktree === 'new-child' || options.worktree === 'new-top-level') {
+    return { selector: options.worktree, workspaceKey: null }
+  }
+  if (options.worktree === 'current' || !options.worktree) {
+    if (simultaneousWriteBatch && options.workspaceUsage === 'write') {
+      return { selector: 'new-child', workspaceKey: null }
+    }
+    return {
+      selector: run.workspace_id ? `id:${run.workspace_id}` : undefined,
+      workspaceKey: run.workspace_id
+    }
+  }
+  return { selector: options.worktree, workspaceKey: null }
+}
+
+/** A write excludes every worker in the workspace; a read only waits for a writer. */
+export function workspaceConflicts(
+  usage: 'read' | 'write',
+  workspaceKey: string,
+  activeWorkspaces: Set<string>,
+  activeWriteWorkspaces: Set<string>
+): boolean {
+  return usage === 'write'
+    ? activeWorkspaces.has(workspaceKey)
+    : activeWriteWorkspaces.has(workspaceKey)
+}
