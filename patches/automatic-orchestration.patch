+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { OrchestrationDb } from '../db/orchestration-db'
+import { OrchestrationWorkflow } from '../../../../shared/orchestration-workflow'
+import type { RunRow, TaskRow } from '../types'
+import { AutomaticRunExecutor, type AutomaticRunHost } from './automatic-run-executor'
+import type * as ReviewModule from './automatic-run-review'
+
+vi.mock('./automatic-run-review', async (importOriginal) => {
+  const actual = await importOriginal<typeof ReviewModule>()
+  return {
+    ...actual,
+    afterTaskCompleted: () => {
+      throw new Error('gate write failed')
+    }
+  }
+})
+
+let db: OrchestrationDb
+let host: AutomaticRunHost
+let launches: string[]
+
+beforeEach(() => {
+  db = new OrchestrationDb(':memory:')
+  launches = []
+  host = {
+    launchTask: async (request) => {
+      launches.push(request.task.source_key ?? request.task.id)
+      const started = db.createStartingWorkerDispatch({
+        taskId: request.task.id,
+        startOptions: {},
+        creator: { kind: 'system' },
+        maxDepth: 8
+      })
+      db.markWorkerDispatchReady(started.dispatch.id)
+      return { dispatchId: started.dispatch.id }
+    },
+    stopDispatch: async () => ({ state: 'stopped', stopped: true }),
+    notifyRun: vi.fn()
+  }
+})
+
+afterEach(() => {
+  db.close()
+})
+
+function createRun(): RunRow {
+  const run = db.createRun({
+    objective: 'failure handling',
+    coordinatorHandle: 'term_coord',
+    coordinatorPaneKey: 'tab:leaf',
+    executionMode: 'automatic',
+    workspaceId: 'wt_main'
+  })
+  db.applyOrchestrationWorkflow({
+    runId: run.id,
+    expectedVersion: 0,
+    workflow: OrchestrationWorkflow.parse({
+      tasks: [
+        { key: 'A', spec: 'A' },
+        { key: 'B', spec: 'B', dependsOn: ['A'] }
+      ]
+    })
+  })
+  db.setRunExecutionState(run.id, 'running')
+  return run
+}
+
+function taskByKey(runId: string, key: string): TaskRow {
+  return db.db
+    .prepare('SELECT * FROM tasks WHERE run_id = ? AND source_key = ?')
+    .get(runId, key) as TaskRow
+}
+
+function complete(task: TaskRow): void {
+  const dispatch = db.db
+    .prepare(
+      "SELECT id FROM dispatch_contexts WHERE task_id = ? AND status IN ('pending','dispatched') LIMIT 1"
+    )
+    .get(task.id) as { id: string }
+  db.settleWorkerReport({
+    taskId: task.id,
+    dispatchId: dispatch.id,
+    outcome: 'succeeded',
+    result: JSON.stringify({ summary: 'done', evidence: [] })
+  })
+}
+
+describe('automatic event handler failure', () => {
+  it('parks the branch behind a gate and wakes the coordinator instead of failing silently', async () => {
+    const run = createRun()
+    const executor = new AutomaticRunExecutor(db, host)
+    executor.trigger(run.id)
+    await executor.drain(run.id)
+    expect(launches).toEqual(['A'])
+
+    complete(taskByKey(run.id, 'A'))
+    executor.trigger(run.id)
+    await executor.drain(run.id)
+
+    expect(db.getTask(taskByKey(run.id, 'A').id)?.status).toBe('completed')
+    expect(db.listPendingGatesForRun(run.id)).toHaveLength(1)
+    expect(launches).toEqual(['A'])
+    expect(db.getRun(run.id)?.execution_state).toBe('running')
+    const event = db.db
+      .prepare(
+        "SELECT state FROM automatic_run_events WHERE run_id = ? AND kind = 'task_completed'"
+      )
+      .get(run.id) as { state: string }
+    expect(event.state).toBe('failed')
+    const mail = db.getUnreadMessages(`run:${run.id}`)
+    expect(
+      mail.some((message) => message.body.includes('Automatic executor could not process'))
+    ).toBe(true)
+  })
+})
diff --git a/src/main/runtime/orchestration/automatic-run/automatic-run-event-failure.ts b/src/main/runtime/orchestration/automatic-run/automatic-run-event-failure.ts
new file mode 100644
index 00000000..7b7f64a2
--- /dev/null
+++ b/src/main/runtime/orchestration/automatic-run/automatic-run-event-failure.ts
@@ -0,0 +1,103 @@
+import type { AutomaticRunEventRow, RunRow, TaskRow } from '../types'
+import type { OrchestrationDb } from '../db'
+import { createAutomaticRunGate } from '../db/automatic-runs/automatic-run-activity-store'
+import { markAutomaticRunEventProcessed } from '../db/automatic-runs/automatic-run-store'
+
+/**
+ * Failure of an event handler must park the branch and wake the coordinator.
+ * It runs after the event transaction rolled back, in its own transaction.
+ */
+export function handleAutomaticEventFailure(
+  db: OrchestrationDb,
+  run: RunRow,
+  event: AutomaticRunEventRow,
+  error: unknown
+): void {
+  const reason =
+    `Automatic executor could not process ${event.kind} for ` +
+    `${event.task_id ?? 'its Task'}: ${error instanceof Error ? error.message : String(error)}`
+  db.db.exec('BEGIN IMMEDIATE')
+  try {
+    const task = event.task_id ? db.getTask(event.task_id) : undefined
+    if (task) {
+      ensureWaitingBranch(db, run.id, task, reason)
+    }
+    db.recordAutomaticWake({
+      runId: run.id,
+      eventId: event.id,
+      eventKey: `event_failed:${event.id}`,
+      reason
+    })
+    markAutomaticRunEventProcessed.call(db, event.id, 'failed')
+    db.db.exec('COMMIT')
+  } catch (failure) {
+    db.db.exec('ROLLBACK')
+    console.warn('[automatic-run] event failure fallback failed', run.id, event.kind, failure)
+    recordFailureWakeOnly(db, run.id, event, reason)
+  }
+}
+
+function ensureWaitingBranch(
+  db: OrchestrationDb,
+  runId: string,
+  task: TaskRow,
+  reason: string
+): void {
+  db.db.exec('SAVEPOINT executor_event_wait')
+  try {
+    createAutomaticRunGate.call(db, {
+      runId,
+      taskId: task.id,
+      question: `${reason} Inspect the Task and resolve this gate to continue.`,
+      options: ['approved', 'changes_requested']
+    })
+    if (task.status === 'pending' || task.status === 'ready') {
+      db.db
+        .prepare(
+          "UPDATE tasks SET status = 'blocked' WHERE id = ? AND status IN ('pending', 'ready')"
+        )
+        .run(task.id)
+    }
+    db.db.exec('RELEASE executor_event_wait')
+  } catch {
+    db.db.exec('ROLLBACK TO executor_event_wait')
+    db.db.exec('RELEASE executor_event_wait')
+    // Last resort: hold the reviewed branch even if the gate row could not be written.
+    const reviewedTaskId = task.review_of_task_id ?? task.id
+    for (const candidate of db.listTasks({ runId })) {
+      if (candidate.status !== 'pending' && candidate.status !== 'ready') {
+        continue
+      }
+      const deps = JSON.parse(candidate.deps) as string[]
+      if (
+        deps.includes(task.id) ||
+        deps.includes(reviewedTaskId) ||
+        candidate.review_of_task_id === reviewedTaskId
+      ) {
+        db.db.prepare("UPDATE tasks SET status = 'blocked' WHERE id = ?").run(candidate.id)
+      }
+    }
+  }
+}
+
+function recordFailureWakeOnly(
+  db: OrchestrationDb,
+  runId: string,
+  event: AutomaticRunEventRow,
+  reason: string
+): void {
+  db.db.exec('BEGIN IMMEDIATE')
+  try {
+    db.recordAutomaticWake({
+      runId,
+      eventId: event.id,
+      eventKey: `event_failed:${event.id}`,
+      reason
+    })
+    markAutomaticRunEventProcessed.call(db, event.id, 'failed')
+    db.db.exec('COMMIT')
+  } catch (failure) {
+    db.db.exec('ROLLBACK')
+    console.error('[automatic-run] could not record event failure wake', runId, event.id, failure)
+  }
+}
