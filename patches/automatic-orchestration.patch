+    dispatchId: dispatch.id,
+    outcome: 'succeeded',
+    result: JSON.stringify({
+      summary,
+      evidence: ['test.txt'],
+      ...(reviewVerdict ? { reviewVerdict } : {})
+    })
+  })
+  expect(settled.action).toBe('settled')
+}
