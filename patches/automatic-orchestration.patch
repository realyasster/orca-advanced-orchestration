diff --git a/src/shared/workspace-todo.test.ts b/src/shared/workspace-todo.test.ts
new file mode 100644
index 00000000..1f6c909b
--- /dev/null
+++ b/src/shared/workspace-todo.test.ts
@@ -0,0 +1,102 @@
+import { describe, expect, it } from 'vitest'
+import {
+  createWorkspaceTodo,
+  insertWorkspaceTodo,
+  isValidWorkspaceTodoText,
+  normalizeWorkspaceTodos,
+  removeWorkspaceTodo,
+  setWorkspaceTodoCompleted,
+  splitWorkspaceTodos,
+  updateWorkspaceTodoText,
+  WorkspaceTodoLimitError,
+  WORKSPACE_TODO_MAX_ITEMS,
+  type WorkspaceTodo
+} from './workspace-todo'
+
+const workspaceId = 'repo::/work/app'
+
+function todo(overrides: Partial<WorkspaceTodo> = {}): WorkspaceTodo {
+  return {
+    id: 'todo-1',
+    workspaceId,
+    text: 'Write release notes',
+    createdAt: 1_000,
+    updatedAt: 1_000,
+    completedAt: null,
+    ...overrides
+  }
+}
+
+describe('workspace todos', () => {
+  it('trims text, orders new items first, and keeps completed items in place', () => {
+    const first = createWorkspaceTodo({ workspaceId, text: '  first  ', id: 'a', now: 1 })
+    const second = createWorkspaceTodo({ workspaceId, text: 'second', id: 'b', now: 2 })
+    const inserted = insertWorkspaceTodo([first], second)
+
+    expect(inserted.map((entry) => entry.id)).toEqual(['b', 'a'])
+    expect(inserted[1]?.text).toBe('first')
+
+    const completed = setWorkspaceTodoCompleted(inserted, 'b', true, 3)
+    const split = splitWorkspaceTodos(completed)
+    expect(split.open.map((entry) => entry.id)).toEqual(['a'])
+    expect(split.completed.map((entry) => entry.id)).toEqual(['b'])
+    expect(split.completed[0]?.completedAt).toBe(3)
+  })
+
+  it('edits text and removes items by identity', () => {
+    const updated = updateWorkspaceTodoText([todo()], 'todo-1', '  revised  ', 2_000)
+    expect(updated[0]).toMatchObject({ text: 'revised', updatedAt: 2_000 })
+    expect(removeWorkspaceTodo(updated, 'todo-1')).toEqual([])
+  })
+
+  it('rejects blank and overlong text', () => {
+    expect(isValidWorkspaceTodoText('   ')).toBe(false)
+    expect(isValidWorkspaceTodoText('x'.repeat(2_001))).toBe(false)
+    expect(isValidWorkspaceTodoText('  keep  ')).toBe(true)
+  })
+
+  it('drops malformed persisted rows without losing valid siblings', () => {
+    const normalized = normalizeWorkspaceTodos([
+      todo({ id: 'valid' }),
+      { ...todo({ id: 'blank' }), text: '   ' },
+      { ...todo({ id: 'bad-time' }), createdAt: Number.NaN },
+      null
+    ])
+    expect(normalized.map((entry) => entry.id)).toEqual(['valid'])
+  })
+
+  it('rejects an insertion that would exceed the workspace limit', () => {
+    const full = Array.from({ length: WORKSPACE_TODO_MAX_ITEMS }, (_, index) =>
+      todo({ id: `t-${index}`, createdAt: index })
+    )
+
+    expect(() => insertWorkspaceTodo(full, todo({ id: 'overflow' }))).toThrow(
+      WorkspaceTodoLimitError
+    )
+    expect(full).toHaveLength(WORKSPACE_TODO_MAX_ITEMS)
+    expect(full.some((entry) => entry.id === 'overflow')).toBe(false)
+  })
+
+  it('deduplicates ids after sorting and before applying the cap', () => {
+    const normalized = normalizeWorkspaceTodos([
+      todo({ id: 'duplicate', text: 'older', createdAt: 1 }),
+      todo({ id: 'duplicate', text: 'newer', createdAt: 2 }),
+      todo({ id: 'keep', createdAt: 3 })
+    ])
+
+    expect(normalized.map((entry) => entry.id)).toEqual(['keep', 'duplicate'])
+    expect(normalized[1]?.text).toBe('newer')
+  })
+
+  it('keeps the same-named workspaces isolated by workspace identity', () => {
+    const other = createWorkspaceTodo({
+      workspaceId: 'repo::/work/other',
+      text: 'other workspace',
+      id: 'other',
+      now: 3
+    })
+    expect(
+      normalizeWorkspaceTodos([todo({ id: 'mine' }), other]).map((entry) => entry.workspaceId)
+    ).toEqual(['repo::/work/app', 'repo::/work/other'])
+  })
+})
diff --git a/src/shared/workspace-todo.ts b/src/shared/workspace-todo.ts
new file mode 100644
index 00000000..0853d146
--- /dev/null
+++ b/src/shared/workspace-todo.ts
@@ -0,0 +1,286 @@
+import type { ExecutionHostId } from './execution-host'
+import { createNonSecureContextUuid } from './non-secure-context-uuid'
+
+/** Manual workspace work items are independent from the agent lifecycle. */
+export const WORKSPACE_TODO_MAX_TEXT_LENGTH = 2_000
+export const WORKSPACE_TODO_MAX_ITEMS = 500
+
+export type WorkspaceTodo = {
+  /** Stable identity; survives text and completion edits. */
+  id: string
+  /** Orca workspace identity (worktree id or folder:<id>). */
+  workspaceId: string
+  text: string
+  createdAt: number
+  updatedAt: number
+  completedAt: number | null
+}
+
+export type WorkspaceTodoAction =
+  | {
+      kind: 'create'
+      workspaceId: string
+      executionHostId?: ExecutionHostId
+      text: string
+      todoId?: string
+      now?: number
+    }
+  | {
+      kind: 'updateText'
+      workspaceId: string
+      executionHostId?: ExecutionHostId
+      todoId: string
+      text: string
+      now?: number
+    }
+  | {
+      kind: 'setCompleted'
+      workspaceId: string
+      executionHostId?: ExecutionHostId
+      todoId: string
+      completed: boolean
+      now?: number
+    }
+  | {
+      kind: 'delete'
+      workspaceId: string
+      executionHostId?: ExecutionHostId
+      todoId: string
+    }
+  | {
+      kind: 'restore'
+      workspaceId: string
+      executionHostId?: ExecutionHostId
+      todo: WorkspaceTodo
+    }
+
+export type WorkspaceTodoActionErrorCode =
+  | 'invalid'
+  | 'not-found'
+  | 'unsupported'
+  | 'save-failed'
+  | 'limit'
+
+export const WORKSPACE_TODO_ACTION_ERROR_CODES: readonly WorkspaceTodoActionErrorCode[] = [
+  'invalid',
+  'not-found',
+  'unsupported',
+  'save-failed',
+  'limit'
+]
+
+export class WorkspaceTodoLimitError extends Error {
+  readonly code = 'workspace-todo-limit' as const
+
+  constructor() {
+    super(`A workspace can contain at most ${WORKSPACE_TODO_MAX_ITEMS} todos.`)
+    this.name = 'WorkspaceTodoLimitError'
+  }
+}
+
+export function isWorkspaceTodoActionErrorCode(
+  value: unknown
+): value is WorkspaceTodoActionErrorCode {
+  return (
+    typeof value === 'string' &&
+    (WORKSPACE_TODO_ACTION_ERROR_CODES as readonly string[]).includes(value)
+  )
+}
+
+export type WorkspaceTodoActionResult =
+  | {
+      ok: true
+      /** False for an idempotent retry or a missing delete; callers must not show a success effect. */
+      changed?: boolean
+    }
+  | { ok: false; code: WorkspaceTodoActionErrorCode; error: string }
+
+/** Round-trip envelope used when the presentation-only pop-out asks the main window to mutate. */
+export type WorkspaceTodoRelayRequest = {
+  requestId: string
+  action: WorkspaceTodoAction
+}
+
+export type WorkspaceTodoRelayResponse = {
+  requestId: string
+  result: WorkspaceTodoActionResult
+}
+
+function isFiniteTimestamp(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0
+}
+
+export function normalizeWorkspaceTodoText(value: string): string {
+  return value.trim()
+}
+
+export function isValidWorkspaceTodoText(value: string): boolean {
+  const text = normalizeWorkspaceTodoText(value)
+  return text.length > 0 && text.length <= WORKSPACE_TODO_MAX_TEXT_LENGTH
+}
+
+export function isWorkspaceTodo(value: unknown): value is WorkspaceTodo {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    return false
+  }
+  const todo = value as Record<string, unknown>
+  return (
+    typeof todo.id === 'string' &&
+    todo.id.length > 0 &&
+    typeof todo.workspaceId === 'string' &&
+    todo.workspaceId.length > 0 &&
+    typeof todo.text === 'string' &&
+    isValidWorkspaceTodoText(todo.text) &&
+    isFiniteTimestamp(todo.createdAt) &&
+    isFiniteTimestamp(todo.updatedAt) &&
+    (todo.completedAt === null || isFiniteTimestamp(todo.completedAt))
+  )
+}
+
+/** Drop corrupt persisted rows without discarding valid siblings; newest id wins, then cap. */
+export function normalizeWorkspaceTodos(value: unknown): WorkspaceTodo[] {
+  if (!Array.isArray(value)) {
+    return []
+  }
+  const sorted = value.filter(isWorkspaceTodo).sort((a, b) => {
+    return b.createdAt - a.createdAt || b.updatedAt - a.updatedAt || a.id.localeCompare(b.id)
+  })
+  const seen = new Set<string>()
+  const unique: WorkspaceTodo[] = []
+  for (const todo of sorted) {
+    if (seen.has(todo.id)) {
+      continue
+    }
+    seen.add(todo.id)
+    unique.push(todo)
+    if (unique.length === WORKSPACE_TODO_MAX_ITEMS) {
+      break
+    }
+  }
+  return unique
+}
+
+export function compareTodosByCreatedAtDesc(a: WorkspaceTodo, b: WorkspaceTodo): number {
+  return b.createdAt - a.createdAt || a.id.localeCompare(b.id)
+}
+
+export function compareCompletedTodosDesc(a: WorkspaceTodo, b: WorkspaceTodo): number {
+  return (b.completedAt ?? 0) - (a.completedAt ?? 0) || compareTodosByCreatedAtDesc(a, b)
+}
+
+export function createWorkspaceTodo(input: {
+  workspaceId: string
+  text: string
+  id?: string
+  now?: number
+}): WorkspaceTodo {
+  const now = input.now ?? Date.now()
+  return {
+    id: input.id ?? createNonSecureContextUuid(),
+    workspaceId: input.workspaceId,
+    text: normalizeWorkspaceTodoText(input.text),
+    createdAt: now,
+    updatedAt: now,
+    completedAt: null
+  }
+}
+
+/** Reject overflow instead of silently dropping the oldest todo on create/restore. */
+export function insertWorkspaceTodo(
+  todos: readonly WorkspaceTodo[],
+  todo: WorkspaceTodo
+): WorkspaceTodo[] {
+  const next = [todo, ...todos.filter((entry) => entry.id !== todo.id)]
+  if (next.length > WORKSPACE_TODO_MAX_ITEMS) {
+    throw new WorkspaceTodoLimitError()
+  }
+  return next.sort(compareTodosByCreatedAtDesc)
+}
+
+export function updateWorkspaceTodoText(
+  todos: readonly WorkspaceTodo[],
+  todoId: string,
+  text: string,
+  now: number
+): WorkspaceTodo[] {
+  const normalized = normalizeWorkspaceTodoText(text)
+  return todos.map((todo) =>
+    todo.id === todoId ? { ...todo, text: normalized, updatedAt: now } : todo
+  )
+}
+
+export function setWorkspaceTodoCompleted(
+  todos: readonly WorkspaceTodo[],
+  todoId: string,
+  completed: boolean,
+  now: number
+): WorkspaceTodo[] {
+  return todos.map((todo) =>
+    todo.id === todoId ? { ...todo, completedAt: completed ? now : null, updatedAt: now } : todo
+  )
+}
+
+export function removeWorkspaceTodo(
+  todos: readonly WorkspaceTodo[],
+  todoId: string
+): WorkspaceTodo[] {
+  return todos.filter((todo) => todo.id !== todoId)
+}
+
+/** Completed items remain in the same workspace list and can be reopened. */
+export function splitWorkspaceTodos(todos: readonly WorkspaceTodo[]): {
+  open: WorkspaceTodo[]
+  completed: WorkspaceTodo[]
+} {
+  const open: WorkspaceTodo[] = []
+  const completed: WorkspaceTodo[] = []
+  for (const todo of todos) {
+    if (todo.completedAt === null) {
+      open.push(todo)
+    } else {
+      completed.push(todo)
+    }
+  }
+  open.sort(compareTodosByCreatedAtDesc)
+  completed.sort(compareCompletedTodosDesc)
+  return { open, completed }
+}
+
+export function isWorkspaceTodoAction(value: unknown): value is WorkspaceTodoAction {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    return false
+  }
+  const action = value as Record<string, unknown>
+  if (typeof action.workspaceId !== 'string' || action.workspaceId.length === 0) {
+    return false
+  }
+  if (action.executionHostId !== undefined && typeof action.executionHostId !== 'string') {
+    return false
+  }
+  switch (action.kind) {
+    case 'create':
+      return (
+        typeof action.text === 'string' &&
+        (action.todoId === undefined || typeof action.todoId === 'string') &&
+        (action.now === undefined || isFiniteTimestamp(action.now))
+      )
+    case 'updateText':
+      return (
+        typeof action.todoId === 'string' &&
+        typeof action.text === 'string' &&
+        (action.now === undefined || isFiniteTimestamp(action.now))
+      )
+    case 'setCompleted':
+      return (
+        typeof action.todoId === 'string' &&
+        typeof action.completed === 'boolean' &&
+        (action.now === undefined || isFiniteTimestamp(action.now))
+      )
+    case 'delete':
+      return typeof action.todoId === 'string'
+    case 'restore':
+      return isWorkspaceTodo(action.todo) && action.todo.workspaceId === action.workspaceId
+    default:
+      return false
+  }
+}
